    "a = math.fabs(-10) # -10의 절대값을 구하는 함수\n",
    "print('math.fabs(-10) :', a)\n",
    "b = math.sin(math.pi/2.0) # sin() 90도를 구하는 함수(라디안 각도 사용)\n",
    "print('math.sin(m.pi/2.0) :', b)"
   ]
